:root{
    --void:#0a0c16;
    --void-2:#10142a;
    --glass-bg: rgba(255,255,255,0.045);
    --glass-bg-hover: rgba(255,255,255,0.075);
    --glass-border: rgba(255,255,255,0.10);
    --glass-border-strong: rgba(255,255,255,0.18);
    --cyan:#5EEAD4;
    --violet:#9C8CFB;
    --ember:#FF9166;
    --text-hi:#EDEDF7;
    --text-mid:#B4B7C9;
    --text-lo:#6D7086;
    --radius:18px;
  }

  *{margin:0;padding:0;box-sizing:border-box;}

  html{scroll-behavior:smooth;}

  body{
    background: radial-gradient(120% 90% at 15% -10%, #1a1f42 0%, var(--void) 45%), var(--void);
    color:var(--text-hi);
    font-family:'Inter', sans-serif;
    overflow-x:hidden;
    position:relative;
    min-height:100vh;
  }

  ::selection{ background:var(--violet); color:var(--void); }

  a{ color:inherit; text-decoration:none; }

  h1,h2,h3{ font-family:'Space Grotesk', sans-serif; letter-spacing:-0.01em; }

  .mono{ font-family:'JetBrains Mono', monospace; }

  /* ---------- background scene-grid canvas ---------- */
  #bg-grid{
    position:fixed; inset:0; z-index:0; pointer-events:none; opacity:0.55;
  }

  /* ---------- layout shell ---------- */
  .wrap{
    position:relative; z-index:2;
    max-width:1180px; margin:0 auto; padding:0 32px;
  }

  /* ---------- glass panel base ---------- */
  .glass{
    background: var(--glass-bg);
    border:1px solid var(--glass-border);
    border-radius: var(--radius);
    backdrop-filter: blur(18px) saturate(140%);
    -webkit-backdrop-filter: blur(18px) saturate(140%);
    box-shadow: 0 8px 40px rgba(0,0,0,0.35), inset 0 1px 0 rgba(255,255,255,0.06);
  }

  /* ---------- nav ---------- */
  header{
    position:fixed; top:18px; left:0; right:0; z-index:50;
    display:flex; justify-content:center;
  }
  nav{
    width:min(920px, calc(100% - 48px));
    display:flex; align-items:center; justify-content:space-between;
    padding:12px 22px;
  }
  .logo{
    font-family:'Space Grotesk', sans-serif; font-weight:700; font-size:17px;
    display:flex; align-items:center; gap:9px; color:var(--text-hi);
  }
  .logo-mark{
    width:26px;height:26px;border-radius:7px;
    background: linear-gradient(135deg, var(--cyan), var(--violet));
    display:flex;align-items:center;justify-content:center;
    font-family:'JetBrains Mono', monospace; font-size:11px; font-weight:500; color:var(--void);
  }
  .nav-links{ display:flex; gap:28px; }
  .nav-links a{
    font-size:14px; color:var(--text-mid); font-weight:500;
    transition:color .25s ease;
    position:relative;
  }
  .nav-links a:hover, .nav-links a:focus-visible{ color:var(--text-hi); }
  .nav-links a::after{
    content:''; position:absolute; left:0; bottom:-4px; height:1px; width:0;
    background:var(--cyan); transition:width .25s ease;
  }
  .nav-links a:hover::after{ width:100%; }

  /* ---------- hero ---------- */
  .hero{
    min-height:100vh;
    display:grid; grid-template-columns: 1.05fr 0.95fr; align-items:center; gap:40px;
    padding-top:110px; padding-bottom:60px;
  }
  .eyebrow{
    display:inline-flex; align-items:center; gap:8px;
    font-family:'JetBrains Mono', monospace; font-size:12px; letter-spacing:0.08em;
    color:var(--cyan); text-transform:uppercase;
    padding:6px 12px; border-radius:100px;
    border:1px solid rgba(94,234,212,0.28); background:rgba(94,234,212,0.06);
    margin-bottom:22px;
  }
  .eyebrow .dot{ width:6px;height:6px;border-radius:50%; background:var(--cyan); box-shadow:0 0 8px var(--cyan); }

  .hero h1{
    font-size:clamp(40px, 5.4vw, 68px);
    line-height:1.04; font-weight:700; color:var(--text-hi);
    margin-bottom:20px;
  }
  .hero h1 span{
    background: linear-gradient(100deg, var(--cyan), var(--violet) 65%);
    -webkit-background-clip:text; background-clip:text; color:transparent;
  }
  .hero p.lede{
    font-size:16.5px; line-height:1.65; color:var(--text-mid); max-width:480px; margin-bottom:34px;
  }
  .cta-row{ display:flex; gap:14px; flex-wrap:wrap; margin-bottom:44px; }
  .btn{
    font-family:'Inter', sans-serif; font-weight:600; font-size:14.5px;
    padding:13px 24px; border-radius:12px; cursor:pointer; border:none;
    display:inline-flex; align-items:center; gap:8px;
    transition:transform .2s ease, box-shadow .2s ease, background .2s ease;
  }
  .btn-primary{
    background:linear-gradient(100deg, var(--cyan), var(--violet));
    color:#0a0c16;
  }
  .btn-primary:hover{ transform:translateY(-2px); box-shadow:0 10px 30px rgba(156,140,251,0.35); }
  .btn-ghost{
    background:var(--glass-bg); border:1px solid var(--glass-border-strong); color:var(--text-hi);
  }
  .btn-ghost:hover{ background:var(--glass-bg-hover); transform:translateY(-2px); }

  .hero-stats{ display:flex; gap:28px; }
  .hero-stats .stat{ }
  .hero-stats .stat .n{ font-family:'Space Grotesk', sans-serif; font-size:22px; font-weight:700; color:var(--text-hi); }
  .hero-stats .stat .l{ font-family:'JetBrains Mono', monospace; font-size:11px; color:var(--text-lo); text-transform:uppercase; letter-spacing:0.06em; margin-top:2px; }

  /* ---------- 3D viewport panel ---------- */
  .viewport{
    position:relative; aspect-ratio:1/1; border-radius:24px; overflow:hidden;
    display:flex; align-items:center; justify-content:center;
  }
  .viewport canvas{ position:absolute; inset:0; width:100%!important; height:100%!important; touch-action:none; }
  .viewport-hud{
    position:absolute; inset:14px; pointer-events:none;
    display:flex; flex-direction:column; justify-content:space-between;
  }
  .hud-row{ display:flex; justify-content:space-between; font-family:'JetBrains Mono', monospace; font-size:10.5px; color:var(--text-lo); letter-spacing:0.05em; }
  .hud-row span.val{ color:var(--cyan); }
  .hud-corner{ position:absolute; width:16px; height:16px; }
  .hud-corner.tl{ top:14px; left:14px; border-top:1.5px solid var(--glass-border-strong); border-left:1.5px solid var(--glass-border-strong); }
  .hud-corner.tr{ top:14px; right:14px; border-top:1.5px solid var(--glass-border-strong); border-right:1.5px solid var(--glass-border-strong); }
  .hud-corner.bl{ bottom:14px; left:14px; border-bottom:1.5px solid var(--glass-border-strong); border-left:1.5px solid var(--glass-border-strong); }
  .hud-corner.br{ bottom:14px; right:14px; border-bottom:1.5px solid var(--glass-border-strong); border-right:1.5px solid var(--glass-border-strong); }

  /* ---------- section shells ---------- */
  section{ padding:120px 0; position:relative; }
  .section-head{ margin-bottom:52px; max-width:640px; }
  .section-head .eyebrow{ margin-bottom:16px; }
  .section-head h2{ font-size:clamp(28px,3.4vw,40px); font-weight:700; color:var(--text-hi); margin-bottom:14px; }
  .section-head p{ color:var(--text-mid); font-size:15.5px; line-height:1.6; }

  .reveal{ opacity:0; transform:translateY(28px); transition:opacity .7s ease, transform .7s ease; }
  .reveal.in{ opacity:1; transform:translateY(0); }

  /* ---------- about ---------- */
  .about-grid{ display:grid; grid-template-columns: 1.3fr 0.7fr; gap:24px; }
  .about-card{ padding:36px; }
  .about-card p{ color:var(--text-mid); line-height:1.75; font-size:15.5px; margin-bottom:16px; }
  .about-card p:last-child{ margin-bottom:0; }
  .about-card strong{ color:var(--text-hi); font-weight:600; }

  .facts-card{ padding:30px; display:flex; flex-direction:column; gap:20px; }
  .fact{ display:flex; flex-direction:column; gap:4px; padding-bottom:18px; border-bottom:1px solid var(--glass-border); }
  .fact:last-child{ border-bottom:none; padding-bottom:0; }
  .fact .k{ font-family:'JetBrains Mono', monospace; font-size:10.5px; color:var(--text-lo); text-transform:uppercase; letter-spacing:0.07em; }
  .fact .v{ font-size:14.5px; color:var(--text-hi); font-weight:500; }

  /* ---------- projects ---------- */
  .project-card{
    padding:34px; margin-bottom:24px;
    transition: transform .12s ease, border-color .3s ease, background .3s ease;
    transform-style:preserve-3d;
  }
  .project-card:hover{ border-color:var(--glass-border-strong); background:var(--glass-bg-hover); }
  .project-top{ display:flex; justify-content:space-between; align-items:flex-start; gap:20px; margin-bottom:16px; flex-wrap:wrap; }
  .project-top h3{ font-size:22px; color:var(--text-hi); font-weight:700; }
  .project-tag{
    font-family:'JetBrains Mono', monospace; font-size:10.5px; text-transform:uppercase; letter-spacing:0.06em;
    padding:5px 11px; border-radius:100px; white-space:nowrap;
  }
  .tag-mobile{ color:var(--violet); background:rgba(156,140,251,0.1); border:1px solid rgba(156,140,251,0.25); }
  .tag-game{ color:var(--cyan); background:rgba(94,234,212,0.08); border:1px solid rgba(94,234,212,0.25); }
  .project-card p.desc{ color:var(--text-mid); line-height:1.7; font-size:14.8px; margin-bottom:20px; max-width:640px; }

  .stack-row{ display:flex; flex-wrap:wrap; gap:8px; margin-bottom:4px; }
  .chip{
    font-family:'JetBrains Mono', monospace; font-size:11px; color:var(--text-mid);
    padding:5px 10px; border-radius:8px; background:rgba(255,255,255,0.035); border:1px solid var(--glass-border);
  }

  .synopsis-map{
    margin-top:22px; padding-top:22px; border-top:1px solid var(--glass-border);
    display:grid; grid-template-columns:repeat(3,1fr); gap:14px;
  }
  .synopsis-node{
    padding:16px; border-radius:12px; background:rgba(255,255,255,0.03); border:1px solid var(--glass-border);
    position:relative;
  }
  .synopsis-node .num{ font-family:'JetBrains Mono', monospace; font-size:10px; color:var(--cyan); margin-bottom:8px; display:block; }
  .synopsis-node .t{ font-size:13.5px; font-weight:600; color:var(--text-hi); line-height:1.4; margin-bottom:6px; }
  .synopsis-node .d{ font-size:12px; color:var(--text-lo); line-height:1.5; }

  /* ---------- skills ---------- */
  .skills-grid{ display:grid; grid-template-columns:repeat(4,1fr); gap: 10px;px; }
  .skill-card{ padding:10px; }
  .skill-card .cat{ font-family:'JetBrains Mono', monospace; font-size:10.5px; color:var(--cyan); text-transform:uppercase; letter-spacing:0.06em; margin-bottom:15px; display:block; }
  .skill-card ul{ list-style:none; display:flex; flex-direction:column; gap:9px; }
  .skill-card li{ font-size:14px; color:var(--text-mid); display:flex; align-items:center; gap:8px; }
  .skill-card li::before{ content:''; width:15px; height:15px; border-radius:50%; background:var(--violet); flex-shrink:0; }

  /* ---------- contact ---------- */
  .contact-panel{
    padding:56px; text-align:center; display:flex; flex-direction:column; align-items:center;
  }
  .contact-panel h2{ font-size:clamp(28px,3.6vw,42px); margin-bottom:16px; }
  .contact-panel p{ color:var(--text-mid); max-width:460px; margin-bottom:34px; line-height:1.6; }
  .contact-links{ display:flex; gap:14px; flex-wrap:wrap; justify-content:center; }
  .contact-links a{
    padding:12px 22px; border-radius:12px;
    font-size:14px; font-weight:600;
    background:var(--glass-bg); border:1px solid var(--glass-border-strong);
    transition:transform .2s ease, background .2s ease, border-color .2s ease;
    display:inline-flex; align-items:center; gap:8px;
  }
  .contact-links a:hover{ transform:translateY(-2px); background:var(--glass-bg-hover); border-color:var(--cyan); }

  footer{ padding:36px 0 50px; text-align:center; }
  footer p{ font-family:'JetBrains Mono', monospace; font-size:11.5px; color:var(--text-lo); }

  /* ---------- responsive ---------- */
  @media (max-width: 880px){
    .hero{ grid-template-columns:1fr; padding-top:130px; }
    .viewport{ order:-1; max-width:340px; margin:0 auto 20px; }
    .about-grid{ grid-template-columns:1fr; }
    .skills-grid{ grid-template-columns:repeat(2,1fr); }
    .synopsis-map{ grid-template-columns:1fr; }
    .nav-links{ display:none; }
    .hero-stats{ flex-wrap:wrap; row-gap:16px; }
  }

  @media (prefers-reduced-motion: reduce){
    *{ animation-duration:0.001ms !important; animation-iteration-count:1 !important; transition-duration:0.001ms !important; scroll-behavior:auto !important; }
  }

  :focus-visible{ outline:2px solid var(--cyan); outline-offset:3px; }
